# API listener
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Local PostgreSQL (match compose.yaml)
DATABASE_URL=postgres://trusttask:trusttask_local_only@localhost:5432/trusttask
# Local-only signing key. Set a generated 32+ character secret in deployment.
SESSION_SECRET=local-only-trusttask-session-secret-change-before-deployment
